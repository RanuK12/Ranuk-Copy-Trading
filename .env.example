###############################################################################
# Polymarket Multi-Strategy Bot — environment template (v3)
# Copy to `.env` and fill in. NEVER commit `.env`.
###############################################################################

# -----------------------------------------------------------------------------
# MODE
# -----------------------------------------------------------------------------
# paper = simulate everything, no on-chain tx
# live  = post real orders to the CLOB
MODE=paper
LOG_LEVEL=INFO

# Comma-separated list of strategies to enable. Options:
#   arbitrage, tail_end, micro_spread, dip_arb, smart_copy, market_making, sniper
#
# NOTE (v3): the BudgetProfile may auto-disable strategies that are not viable
# for your capital tier (e.g. micro_spread on a $20-$30 budget). See the log
# on startup for the effective list.
STRATEGIES_ENABLED=arbitrage,tail_end,smart_copy

# -----------------------------------------------------------------------------
# Capital & sizing
# -----------------------------------------------------------------------------
# The BudgetProfile reads this and picks a tier:
#   <= $50       micro      (tail_end only, ~$2-$10 per trade)
#   <= $300      small      (tail_end + smart_copy + sniper)
#   <= $5000     standard   (full 7-strategy set, v2 defaults)
#   > $5000      large      (recommend Tier 2 hardware wallet custody)
TOTAL_CAPITAL_USDC=1000

# Per-trade target size BEFORE the budget profile caps it. Tier micro/small
# will clamp this to a safer value automatically.
DEFAULT_TRADE_SIZE_USDC=20

# -----------------------------------------------------------------------------
# Wallet (v3: multiple tiers — all credentials are OPTIONAL in .env)
# -----------------------------------------------------------------------------
# Preferred: Tier 1 encrypted keyring. Run once:
#     python main.py --setup-wallet
# and leave POLY_PRIVATE_KEY empty. The bot will prompt for the password at
# startup (or read it from WALLET_PASSWORD below, useful for systemd / PM2).
#
# WALLET_MODE options:
#   (unset|auto)            try keyring first, fall back to POLY_PRIVATE_KEY
#   rotation                Tier 3: round-robin across slots (--setup-wallet
#                           has a multi-slot flow)
#   strategy-assigned       Tier 3: one slot per strategy; set
#                           WALLET_ARBITRAGE, WALLET_TAIL_END, ... below
#   hardware                Tier 2 stub (Ledger/Trezor)
#   cloud_kms               Tier 4 stub (AWS KMS / HashiCorp Vault)
WALLET_MODE=auto

# Optional password for decrypting the Tier 1 key without an interactive TTY.
# Leave blank to be prompted at startup.
WALLET_PASSWORD=

# Tier 3 rotation — only if WALLET_MODE=rotation
WALLET_ROTATION_KEYS=slot1,slot2,slot3

# Tier 3 strategy-assigned — only if WALLET_MODE=strategy-assigned
# WALLET_ARBITRAGE=hot
# WALLET_TAIL_END=cold
# WALLET_SMART_COPY=cold

# Tier 4 cloud KMS (stub) — only if WALLET_MODE=cloud_kms
# KMS_KEY_ID=arn:aws:kms:...

# Funder = the Polymarket proxy wallet that holds USDC. Visible on your
# Polymarket profile URL (see docs/CONECTAR_WALLET.md).
POLY_FUNDER=0xyour_proxy_wallet_address

# Signature type for the CLOB client:
#   0 = EOA (MetaMask / hardware wallets)
#   1 = Email / Magic wallet (delegated signing) — most common
#   2 = Browser-wallet proxy
POLY_SIGNATURE_TYPE=1

# Optional API key (py-clob-client will create/derive one if blank)
POLY_API_KEY=

# Tier 0 fallback — plaintext private key in .env. DEPRECATED in v3; use
# --setup-wallet instead. Leaving this set for paper mode / quick tests is
# fine, but the bot will print a warning on startup.
POLY_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Polymarket APIs
# -----------------------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com
CLOB_WSS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws

# -----------------------------------------------------------------------------
# Polygon RPC (private + redundant). Alchemy / QuickNode recommended.
# -----------------------------------------------------------------------------
ALCHEMY_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
QUICKNODE_HTTP_URL=
QUICKNODE_WSS_URL=

# -----------------------------------------------------------------------------
# Notifications (v3) — ALL CHANNELS ARE OPTIONAL
# -----------------------------------------------------------------------------
# If every NOTIFY_* below is false or unset, the bot falls back to logging
# notifications at the correct level. Desktop toast is the recommended
# default so Telegram is no longer required.
NOTIFY_DESKTOP=true           # plyer-based desktop notifications
NOTIFY_SOUND=true             # beepy audio cues
NOTIFY_TELEGRAM=false         # set true to also forward to Telegram
NOTIFY_EMAIL=false            # critical-only SMTP alerts

# Telegram — only used if NOTIFY_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email — only used if NOTIFY_EMAIL=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# -----------------------------------------------------------------------------
# Persistence / observability (v3)
# -----------------------------------------------------------------------------
# Optional Supabase mirror
SUPABASE_URL=
SUPABASE_KEY=

# Hot-reloadable config file (see config_live.yaml.example)
CONFIG_LIVE_PATH=./config_live.yaml

# Web dashboard (only if started via --dashboard web / --dashboard tui+web)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# -----------------------------------------------------------------------------
# Risk limits (fractions of capital; 0.05 == 5%). The BudgetProfile will
# override some of these for micro / small tiers — the effective values
# are printed on startup.
# -----------------------------------------------------------------------------
MAX_EXPOSURE_PER_MARKET=0.05
MAX_EXPOSURE_PER_STRATEGY=0.25
DAILY_LOSS_CAP=0.05
MONTHLY_LOSS_CAP=0.15
MAX_DRAWDOWN=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_SLIPPAGE=0.02
API_ERROR_PAUSE_THRESHOLD=3
API_ERROR_PAUSE_SECONDS=300

# -----------------------------------------------------------------------------
# Strategy-specific tuning (unchanged from v2)
# -----------------------------------------------------------------------------
ARB_MIN_PROFIT=0.01
ARB_MIN_VOLUME_USDC=1000

TAIL_END_MAX_DAYS=7
TAIL_END_MIN_PRICE=0.93
TAIL_END_STOP_LOSS=0.88

MICRO_PRICE_MIN=0.05
MICRO_PRICE_MAX=0.10
MICRO_MIN_SPREAD=0.05
MICRO_MIN_VOLUME_PER_MIN=500
MICRO_CAPITAL_PCT=0.20

DIP_MIN_DROP=0.15
DIP_LOOKBACK_SECONDS=3

SMART_WALLETS=
COPY_MIN_WIN_RATE=0.60
COPY_MIN_PROFIT_FACTOR=1.5
COPY_MIN_TOTAL_PNL_USDC=500
COPY_MIN_CONSISTENCY=0.70
COPY_MAX_SINGLE_TRADE_PCT=0.30

MM_MAX_TOTAL_PRICE=0.98
MM_LADDER_LEVELS=3

SNIPER_PRICES=0.01,0.02,0.03
SNIPER_WEIGHTS=0.5,0.3,0.2

# -----------------------------------------------------------------------------
# Intervals (seconds)
# -----------------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
DASHBOARD_REFRESH_SECONDS=1
POLY_RATE_LIMIT_PER_MIN=60

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
STATE_FILE=./bot_state.json
