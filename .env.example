###############################################################################
# Polymarket Copy-Trading Bot — environment template
#
# 1. Copy this file to `.env`      ->  cp .env.example .env
# 2. Fill in the values below.
# 3. NEVER commit `.env` to git.   (It is already in .gitignore.)
###############################################################################

# -----------------------------------------------------------------------------
# MODE
# -----------------------------------------------------------------------------
# When true, the bot will NOT send real transactions. It will only log
# simulated fills and track theoretical PnL. Flip to "false" for live trading.
PAPER_TRADING=true

# Console log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# POLYGON RPC
# -----------------------------------------------------------------------------
# A private, low-latency RPC is STRONGLY recommended (Alchemy / QuickNode /
# Chainstack). Public RPCs will cause you to lose the latency race.
POLYGON_HTTP_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_WSS_RPC=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# -----------------------------------------------------------------------------
# POLYMARKET WALLET (for order execution)
# -----------------------------------------------------------------------------
# EOA private key that SIGNS orders (NO 0x prefix is also accepted).
# This key must control the funder address below (or be delegated to it).
PRIVATE_KEY=0xyour_private_key_here

# Funder address = the Polygon address that actually holds your USDC on
# Polymarket. For email / Magic / browser-proxy wallets this is the proxy
# address; for EOA wallets it is the same as the signer.
FUNDER_ADDRESS=0xyour_funder_address_here

# Signature type:
#   0 = EOA (MetaMask / hardware wallets)
#   1 = Email / Magic (delegated signing)  <-- most common Polymarket users
#   2 = Browser-wallet proxy
SIGNATURE_TYPE=1

# -----------------------------------------------------------------------------
# POLYMARKET CLOB / DATA APIs
# -----------------------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com
CLOB_WSS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws

# -----------------------------------------------------------------------------
# COPY-TRADING CONFIG
# -----------------------------------------------------------------------------
# Comma-separated list of up to 10 "smart money" proxy-wallet addresses to
# mirror. Pick them from https://polymarket.com/leaderboard (click a user ->
# copy the address from the URL). Prefer wallets with a consistent positive
# ROI over the last 3-6 months in focused categories (Sports, Crypto, etc.).
SMART_WALLETS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Fixed notional in USDC that will be spent to replicate each detected trade.
TRADE_AMOUNT_USDC=20

# Max allowed slippage (fraction). 0.02 == 2%.
# If the current price is > (detected_price * (1 + MAX_SLIPPAGE)), skip trade.
MAX_SLIPPAGE=0.02

# Only replicate BUYs (default). Set to false to also mirror SELLs.
ONLY_BUYS=true

# How often to poll each wallet's data-api /trades endpoint (seconds).
# Set low for responsiveness, but respect public-API rate limits.
POLL_INTERVAL_SECONDS=3

# Heartbeat: print current Polygon block height every N seconds.
BLOCK_HEARTBEAT_SECONDS=15

# File where the bot persists which markets it has already copied
# (prevents duplicate positions across restarts).
STATE_FILE=./bot_state.json
