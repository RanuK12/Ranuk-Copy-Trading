###############################################################################
# Polymarket Multi-Strategy Bot — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
###############################################################################

# -----------------------------------------------------------------------------
# MODE
# -----------------------------------------------------------------------------
# paper = simulate everything, no on-chain tx
# live  = post real orders to the CLOB
MODE=paper
LOG_LEVEL=INFO

# Comma-separated list of strategies to enable. Options:
#   arbitrage, tail_end, micro_spread, dip_arb, smart_copy, market_making, sniper
STRATEGIES_ENABLED=arbitrage,tail_end,smart_copy

# -----------------------------------------------------------------------------
# Polymarket wallet
# -----------------------------------------------------------------------------
POLY_PRIVATE_KEY=0xyour_eoa_private_key
POLY_FUNDER=0xyour_proxy_wallet_address
POLY_API_KEY=                # optional; bot will derive via create_or_derive_api_creds
POLY_SIGNATURE_TYPE=1        # 0=EOA, 1=Email/Magic (default), 2=Browser proxy

# -----------------------------------------------------------------------------
# Polymarket APIs
# -----------------------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com
CLOB_WSS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws

# -----------------------------------------------------------------------------
# Polygon RPC (primary + failover). Private, low-latency nodes REQUIRED.
# -----------------------------------------------------------------------------
ALCHEMY_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
QUICKNODE_WSS_URL=wss://your-endpoint.polygon-mainnet.quiknode.pro/YOUR_QN_KEY
QUICKNODE_HTTP_URL=https://your-endpoint.polygon-mainnet.quiknode.pro/YOUR_QN_KEY

# -----------------------------------------------------------------------------
# Supabase (state persistence + realtime dashboards)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_service_role_key

# -----------------------------------------------------------------------------
# Telegram alerts / remote kill-switch
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-your_bot_token
TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Capital & sizing
# -----------------------------------------------------------------------------
TOTAL_CAPITAL_USDC=1000           # Used by risk manager for % caps
DEFAULT_TRADE_SIZE_USDC=20

# -----------------------------------------------------------------------------
# Risk limits (all fractions; 0.05 == 5%)
# -----------------------------------------------------------------------------
MAX_EXPOSURE_PER_MARKET=0.05
MAX_EXPOSURE_PER_STRATEGY=0.25
DAILY_LOSS_CAP=0.05
MONTHLY_LOSS_CAP=0.15
MAX_DRAWDOWN=0.10
MAX_CONSECUTIVE_LOSSES=4
MAX_SLIPPAGE=0.02
API_ERROR_PAUSE_THRESHOLD=3
API_ERROR_PAUSE_SECONDS=300

# -----------------------------------------------------------------------------
# Strategy-specific tuning
# -----------------------------------------------------------------------------
# Arbitrage: Sum-to-One
ARB_MIN_PROFIT=0.01               # 1% minimum after gas
ARB_MIN_VOLUME_USDC=1000

# Tail-End
TAIL_END_MAX_DAYS=7
TAIL_END_MIN_PRICE=0.93
TAIL_END_STOP_LOSS=0.88

# Micro-Spread
MICRO_PRICE_MIN=0.05
MICRO_PRICE_MAX=0.10
MICRO_MIN_SPREAD=0.05
MICRO_MIN_VOLUME_PER_MIN=500
MICRO_CAPITAL_PCT=0.20            # max 20% of capital in this strat

# Dip-Arb (crypto 15-min markets)
DIP_MIN_DROP=0.15                 # 15% in 3 seconds
DIP_LOOKBACK_SECONDS=3

# Smart Copy
SMART_WALLETS=                    # comma-separated seed wallets (optional)
COPY_MIN_WIN_RATE=0.60
COPY_MIN_PROFIT_FACTOR=1.5
COPY_MIN_TOTAL_PNL_USDC=500
COPY_MIN_CONSISTENCY=0.70
COPY_MAX_SINGLE_TRADE_PCT=0.30

# Market Making
MM_MAX_TOTAL_PRICE=0.98           # only post if YES+NO bid < 0.98
MM_LADDER_LEVELS=3

# Sniper (GTC deep-discount)
SNIPER_PRICES=0.01,0.02,0.03
SNIPER_WEIGHTS=0.5,0.3,0.2

# -----------------------------------------------------------------------------
# Intervals (seconds)
# -----------------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
DASHBOARD_REFRESH_SECONDS=1
POLY_RATE_LIMIT_PER_MIN=60

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
STATE_FILE=./bot_state.json
